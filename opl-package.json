{
  "schema_version": "opl.package.v2",
  "identity": {
    "id": "kindle-pilot",
    "version": "0.2.3",
    "intent": "extension",
    "name": {
      "zh-CN": "Kindle Pilot",
      "en-US": "Kindle Pilot"
    },
    "summary": {
      "zh-CN": "由 Agent 协助完成 Kindle 装机、阅读配置与书库维护。",
      "en-US": "Agent-guided Kindle setup, reading configuration, and library maintenance."
    },
    "description": {
      "zh-CN": "按兼容清单管理 Kindle，配置阅读环境并维护原生书库。",
      "en-US": "Manage a Kindle against its compatibility manifest, configure reading environments, and preserve the native library."
    },
    "routing_summary": {
      "zh-CN": "使用 Kindle Pilot 管理 Kindle，按兼容清单推进并逐项回读设备状态。",
      "en-US": "Manage a Kindle through compatibility checks and explicit device readback."
    },
    "publisher": "gaofeng21cn",
    "license": "MIT",
    "icon": "assets/branding/kindle-pilot-logo.png",
    "repository": "https://github.com/gaofeng21cn/kindle-pilot"
  },
  "dependencies": {
    "opl_base": "^2.0.0",
    "runtimes": [
      {
        "name": "python",
        "version": ">=3.10"
      }
    ]
  },
  "provides": {
    "skills": [
      {
        "id": "kindle-pilot",
        "path": "./skills/kindle-pilot",
        "exposure": "default"
      }
    ],
    "module_ids": [
      "kindle-pilot.host.v1",
      "kindle.device.setup.v1",
      "kindle.mtp.transfer.v1",
      "kindle.reading.environment.v1",
      "kindle.account.reading.v1",
      "kindle.library.preservation.v1",
      "kindle.native.collections.v1",
      "kindle.wireless.maintenance.v1"
    ],
    "cli_bin": [
      {
        "name": "kindle-pilot",
        "path": "bin/kindle-pilot"
      }
    ]
  },
  "distribution": {
    "oci": "ghcr.io/gaofeng21cn/one-person-lab-packages/kindle-pilot",
    "visibility": "public"
  },
  "host_hints": {
    "codex": {
      "sync_enabled": false,
      "plugin_name": "kindle-pilot",
      "category": "Productivity",
      "capabilities": [
        "Interactive",
        "Device setup",
        "USB/MTP transfer",
        "Reading environment",
        "Native collections",
        "Wireless maintenance",
        "Library preservation"
      ]
    }
  }
}
